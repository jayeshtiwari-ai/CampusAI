# CampusAI Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials:
#   copy .env.example .env

# ------------------------------------------------------------------------------
# 1. Groq Cloud API Settings (Free key from https://console.groq.com)
# ------------------------------------------------------------------------------
# Your Groq API key for LLM generation and Whisper Speech-to-Text
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Groq LLM Model name for grounded query answering (default: llama-3.3-70b-versatile or openai/gpt-oss-20b)
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Groq Whisper STT Model for low-latency audio transcription
GROQ_STT_MODEL=whisper-large-v3-turbo

# ------------------------------------------------------------------------------
# 2. Embedding & FAISS Vector Database Settings
# ------------------------------------------------------------------------------
# HuggingFace sentence transformer embedding model (Multilingual support: EN, HI, MR)
EMBED_MODEL=intfloat/multilingual-e5-small

# Top-K chunk retrieval count for vector context search
RAG_TOP_K=5

# Minimum similarity score threshold for confidence gating (0.0 to 1.0)
RAG_MIN_SCORE=0.5

# ------------------------------------------------------------------------------
# 3. Speech-to-Text (TTS) Voice Settings
# ------------------------------------------------------------------------------
# Neural TTS Voice for English replies
VOICE_EN=en-IN-NeerjaNeural

# Neural TTS Voice for Hindi & Hinglish replies
VOICE_HI=hi-IN-SwaraNeural

# Neural TTS Voice for Hinglish replies
VOICE_HINGLISH=hi-IN-SwaraNeural

# Neural TTS Voice for Marathi replies
VOICE_MR=mr-IN-AarohiNeural

# ------------------------------------------------------------------------------
# 4. Telegram Human Escalation Notifications (Optional)
# ------------------------------------------------------------------------------
# Telegram bot token from @BotFather for sending human staff alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram group/admin Chat ID to receive staff escalation alerts
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 5. College Metadata & Server Network Settings
# ------------------------------------------------------------------------------
# Official name of your institution displayed on UI and spoken by AI bot
COLLEGE_NAME=CampusAI Engineering College

# Server bind host address (0.0.0.0 for local network accessibility)
HOST=0.0.0.0

# FastAPI server port
PORT=8000
